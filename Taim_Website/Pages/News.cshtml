@page
@model Taim_Website.Pages.NewsModel
@{
    ViewData["Title"] = "News page";
}

<h2>Latest News & Events</h2>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Autumn Classic Car Show</h5>
        <p class="card-text">Join us at Belfast City Hall this November for our annual showcase of vintage cars.</p>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Member Discount Offer</h5>
        <p class="card-text">Get 20% off all merchandise this month — available to all members!</p>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Winter Meet-Up</h5>
        <p class="card-text">A relaxed meet at the Titanic Quarter car park. Hot drinks on site.</p>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Garage Open Day</h5>
        <p class="card-text">Local specialists will show restoration work and answer questions.</p>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Photo Contest</h5>
        <p class="card-text">Send in your best club photos before the end of the month. Winners get free merch.</p>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Spring Run Announcement</h5>
        <p class="card-text">Route planning starts next week. Members can suggest stops on the forum.</p>
    </div>
</div>
