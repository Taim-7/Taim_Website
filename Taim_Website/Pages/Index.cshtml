@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div id="homeCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/img/carousel1.jpg" class="d-block w-100" alt="Vintage Car Rally" style="height: 400px; object-fit: cover;">
            <div class="carousel-caption d-block bg-dark bg-opacity-50 rounded">
                <h5 style="color: #ece8e2;">Reliving the Golden Age</h5>
                <p>Join Northern Ireland's premier vintage car community.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="/img/carousel2.jpg" class="d-block w-100" alt="Engine Restoration" style="height: 400px; object-fit: cover;">
            <div class="carousel-caption d-block bg-dark bg-opacity-50 rounded">
                <h5 style="color: #ece8e2;">Expert Restoration Advice</h5>
                <p>Learn from the masters of mechanics.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="/img/carousel3.jpg" class="d-block w-100" alt="Club Meetup" style="height: 400px; object-fit: cover;">
            <div class="carousel-caption d-block bg-dark bg-opacity-50 rounded">
                <h5 style="color: #ece8e2;">Community Events</h5>
                <p>Weekly meet-ups and seasonal runs.</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<div class="row mb-5 text-center">
    <div class="col-lg-8 offset-lg-2">
        <h2 class="mb-3">Driven by Passion Since 2008</h2>
        <p>
            Founded by Michel Osman, Wacky Kar Klub started as a small gathering of friends and has grown into a diverse community.
            Whether you are a master restorer or just bought your first classic, there is a place for you here.
        </p>
        <a href="/About" class="btn btn-primary btn-lg mt-3">Read Our History</a>
    </div>
</div>

<hr class="my-5">

<div class="row text-center">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0 bg-transparent">
            <div class="card-body">
                <h3 class="h4">Club Shop</h3>
                <p>From branded hoodies and caps to essential replacement badges and mats.</p>
                <a href="/Merch" class="btn btn-outline-primary">Browse Merchandise</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0 bg-transparent">
            <div class="card-body">
                <h3 class="h4">Expert Services</h3>
                <p>We offer MOT servicing, maintenance advice, refurbishment, and classic car hire.</p>
                <a href="/Services" class="btn btn-outline-primary">View Services</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0 bg-transparent">
            <div class="card-body">
                <h3 class="h4">News & Events</h3>
                <p>Join us for our next meet-up, the "Autumn Classic," or read the latest club news.</p>
                <a href="/News" class="btn btn-outline-primary">See What’s On</a>
            </div>
        </div>
    </div>
</div>
