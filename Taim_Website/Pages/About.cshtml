@page
@model Taim_Website.Pages.AboutModel
@{
    ViewData["Title"] = "About Us";
}

<div class="row mb-5">
    <div class="col-12 text-center">
        <h1 class="display-4">About Wacky Kar Klub</h1>
        <p>Bringing vintage enthusiasts together since 2008.</p>
        <hr class="w-50 mx-auto">
    </div>
</div>

<div class="row align-items-center mb-5">
    <div class="col-md-6">
        <img src="/img/about-history.jpg" class="img-fluid rounded shadow" alt="WKK Club Members">
    </div>
    <div class="col-md-6">
        <h2>Where It All Started</h2>
        <p>
            The Wacky Kar Klub was founded in 2008 by Michel Osman. Originally established to serve older individuals
            who wanted to share their appreciation for the engineering of the past, the club began as a small,
            local group of like-minded hobbyists.
        </p>
        <p>
            Over the years, the club has evolved significantly. We have seen a surge of interest from a younger generation
            of vintage car fans. Today, our membership is more diverse than ever, with an active age group ranging from
            18 to upwards of 45 years old.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-md-12">
        <div class="p-5 rounded bg-white shadow-sm border-start border-4 border-danger">
            <h2>Our Mission</h2>
            <p>
                Our mission is to create a hub that brings all vintage car enthusiasts together, regardless of age or
                experience level. We are dedicated to promoting the preservation of antique vehicles across Northern Ireland.
            </p>
            <p class="mb-0">
                We aim to help our members not only through social events but by providing access to specialized knowledge,
                news updates, and high-quality services.
            </p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <h3 class="mb-4 text-center">Why Join WKK?</h3>
    </div>
    <div class="col-md-3 text-center mb-3">
        <h5>Community</h5>
        <p class="small">Connect with hundreds of local petrolheads.</p>
    </div>
    <div class="col-md-3 text-center mb-3">
        <h5>Support</h5>
        <p class="small text">Access to MOT servicing and maintenance advice.</p>
    </div>
    <div class="col-md-3 text-center mb-3">
        <h5>Events</h5>
        <p class="small">Regular meet-ups, classic runs, and social gatherings.</p>
    </div>
    <div class="col-md-3 text-center mb-3">
        <h5>Memorabilia</h5>
        <p class="small">Exclusive access to club merchandise.</p>
    </div>
</div>