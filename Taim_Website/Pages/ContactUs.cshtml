@page
@model Taim_Website.Pages.ContactUsModel
@{
    ViewData["Title"] = "Contact Us";
}

<h2>Contact Us</h2>
<p>If you’d like to get in touch, fill out the form below or visit us in person.</p>

<form class="mt-3 was-validated" asp-page="/Thanks">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" placeholder="Your Name" required />
        <div class="invalid-feedback">Enter your name.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" placeholder="your@email.com" required />
        <div class="invalid-feedback">Enter a valid email.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Message</label>
        <textarea class="form-control" rows="4" required></textarea>
        <div class="invalid-feedback">Write a short message.</div>
    </div>

    <button type="submit" class="btn btn-primary">Send Message</button>
</form>


<br />
